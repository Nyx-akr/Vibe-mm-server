# All values are optional - the server runs with zero configuration.
# Render sets PORT itself; do not set it there.

# PORT=8787
# HOST=0.0.0.0

# Optional keyed providers (dormant when unset)
# BIRDEYE_API_KEY=
# GOPLUS_API_KEY=

# Static frontend directory, relative to the server folder (default: public)
# PUBLIC_DIR=public

# On-disk archive. On by default, no credentials needed - the server writes
# log/YYYY-MM-DD.jsonl plus snapshot.json under this directory and reloads the
# snapshot on boot, so the series outlive a restart.
# ARCHIVE_DIR=./data             # default: ./data (gitignored)
# ARCHIVE_DISABLED=1             # run RAM-only; loses everything on restart
# STORE_FLUSH_MS=30000           # 30s; local appends are free, so keep it fast
# STORE_OBSERVATION_FLUSH_MS=60000
# HISTORY_MAX_AGE_MS=21600000    # 6h; older samples are dropped so a sleep gap
#                                # cannot skew a z-score baseline

# Tuning
# MAX_ROWS=30
# CACHE_TTL_MS=500
# GT_CACHE_TTL_MS=60000
# DS_CACHE_TTL_MS=1000
# FETCH_TIMEOUT_MS=9000
# TRADES_CACHE_TTL_MS=180000
# INTEL_CACHE_TTL_MS=300000
# ROTATION_POOLS=12
# ROTATION_REFRESH_MS=20000
