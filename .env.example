# All values are optional - the server runs with zero configuration.
# Render sets PORT itself; do not set it there.

# PORT=8787
# HOST=0.0.0.0

# Optional keyed providers (dormant when unset)
# BIRDEYE_API_KEY=
# GOPLUS_API_KEY=

# Static frontend directory, relative to the server folder (default: public)
# PUBLIC_DIR=public

# Optional Firestore persistence. Without it the server keeps its baselines,
# stage machine and holder series in RAM only, and loses them on every sleep,
# deploy or restart. Paste the service-account JSON (or its base64) as one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
# FIREBASE_PROJECT_ID=           # only if it differs from the key's project_id
# STORE_FLUSH_MS=600000          # 10 min; one document per changed pool per flush
# HISTORY_MAX_AGE_MS=21600000    # 6h; older samples are dropped so a sleep gap
#                                # cannot skew a z-score baseline

# Tuning
# MAX_ROWS=30
# CACHE_TTL_MS=500
# GT_CACHE_TTL_MS=60000
# DS_CACHE_TTL_MS=1000
# FETCH_TIMEOUT_MS=9000
# TRADES_CACHE_TTL_MS=180000
# INTEL_CACHE_TTL_MS=300000
# ROTATION_POOLS=12
# ROTATION_REFRESH_MS=20000
